{
  "name": "vite-portfolio",
  "homepage": "https://fazeich.github.io/portfolio",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "start": "vite --config configs/vite.config.ts",
    "coop": "vite --config configs/vite.config.ts --host 0.0.0.0",
    "build": "vite build --config configs/vite.config.ts",
    "lint": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --config configs/playwright.config.ts",
    "preview": "vite preview",
    "predeploy": "npm run build && copy dist\\index.html dist\\404.html",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "effector": "^23.3.0",
    "effector-react": "^23.3.0",
    "gh-pages": "^6.3.0",
    "jiti": "^2.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "react-social-icons": "^6.22.0",
    "styled-components": "^6.1.14",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.18.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.9.5"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
